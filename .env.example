# === 运行时数据库（按环境隔离，不要提交真实密码） ===
# 部署脚本在 /root/.agent-observatory/config.env 生成本机配置，不要复制到共享仓库。
# 开发库 agent_observatory / ci 库 agent_observatory_ci / 体验库 agent_observatory_test
AGENT_OBS_DATABASE_URL=postgresql+asyncpg://observatory:change-me@127.0.0.1:55433/agent_observatory
# 本机独立部署默认使用 55433；真实随机口令由部署脚本生成。
# AGENT_OBS_ENV_FILE=/root/.agent-observatory/config.env
AGENT_OBS_HOST=127.0.0.1
AGENT_OBS_PORT=8125

# 自动化测试指向 ci 库，与开发 / 体验严格分离。
# TEST_DATABASE_URL 由 conftest 读取。
TEST_DATABASE_URL=postgresql+asyncpg://observatory:change-me@127.0.0.1:55433/agent_observatory_ci

# === 应用级配置 ===
# 留空时使用运行用户 home 下的默认目录；需要自定义时填写绝对路径。
# AGENT_OBS_HOME=/home/your-user/.agent-observatory
# AGENT_OBS_CODEX_HOME=/home/your-user/.codex
# AGENT_OBS_PI_HOME=/home/your-user/.pi
# AGENT_OBS_XDCODE_HOME=/home/your-user/.xdcode
# AGENT_OBS_STEPGO_HOME=/home/your-user/.stepgo

# Indexer worker
AGENT_OBS_WORKER_HEARTBEAT_INTERVAL=10
AGENT_OBS_INDEXER_POLL_INTERVAL=2
AGENT_OBS_DISCOVERY_ENABLED=true
AGENT_OBS_INSIGHTS_ENABLED=true
AGENT_OBS_MEMORIES_ENABLED=true
AGENT_OBS_INSIGHTS_BACKFILL_DAYS=90
AGENT_OBS_LOCAL_SOURCE_POLL_INTERVAL=5
# 可选：覆盖 StepCode / Claude 的标准记忆根目录。
# AGENT_OBS_STEPCODE_HOME=/home/your-user/.stepcode/codex
# AGENT_OBS_CLAUDE_PROJECTS_ROOT=/home/your-user/.claude/projects
# 可选：agent:path CSV，补充非标准数据根。
# AGENT_OBS_EXTRA_ROOTS=dsh:/srv/.dsh/sessions,generic:/srv/custom-agent

# Session Cookie（仅 dev 用；生产从安全配置读取）
AGENT_OBS_SESSION_SECRET=dev-only-change-me-use-random-64-chars

# API Token 签名密钥（仅 dev）
AGENT_OBS_API_TOKEN_SECRET=dev-only-change-me-use-random-64-chars

# 允许的 workspace 路径（绝对路径，多个用逗号分隔；留空 = 不限制）
AGENT_OBS_ALLOWED_WORKSPACES=/home/your-user/workspace

# 审计日志最小级别
AGENT_OBS_LOG_LEVEL=INFO

# === 临时管理员 bootstrap（仅首次启动应急；日常用账号密码） ===
AGENT_OBS_BOOTSTRAP_TOKEN=dev-only-bootstrap-admin-token
# 真实账号与密码只写入本机的 config.env / credentials.env；两者已被 .gitignore 忽略。
# 多台机器共享源码目录时，仍不要把凭据、数据库、日志或导出文件放进仓库。
# 本机部署默认只读，不开放 Storage 删除功能。
AGENT_OBS_RETENTION_ENABLED=false
